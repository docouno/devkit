{
  "name": "@docouno/devkit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:types": "tsc --project tsconfig.json --noEmit",
    "check:format": "prettier --check .",
    "check:lint": "eslint tooling test/*.test.ts test/*.mjs 'packages/env/{src,bin}/*.js' 'packages/env/test/*.mjs' --no-ignore --max-warnings=0",
    "check:shell": "bash -n tooling/node.sh tooling/launcher.sh runtime/devkit.sh runtime/guard.sh runtime/rust-check.sh test/verify-consumers.sh test/verify-registry.sh",
    "fix:format": "prettier --write .",
    "test:core": "node --test --test-reporter=@docouno/env/node-test-reporter --test-concurrency=1 test/*.test.ts",
    "test:env": "npm test --workspace=@docouno/env",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run check:shell && npm run test:core && npm run test:env"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
