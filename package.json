{
  "name": "@docouno/devkit-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "check:types": "node node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "check:format": "node node_modules/prettier/bin/prettier.cjs --check .",
    "check:lint": "node node_modules/eslint/bin/eslint.js tooling/*.mjs tooling/npm-inputs/*.mjs test/*.mjs 'packages/env/{src,bin}/*.js' 'packages/env/test/*.mjs' --no-ignore --max-warnings=0",
    "check:shell": "sh -n runtime/devkit.sh && bash -n test/verify-consumers.sh test/verify-registry.sh test/verify-bootstrap.sh test/verify-public.sh",
    "fix:format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "test:npm-inputs": "node --test --test-concurrency=1 test/npm-inputs.test.mjs",
    "test:env": "npm test --workspace=@docouno/env",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run check:shell"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
