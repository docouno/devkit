{
  "name": "devkit-react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.18.0"
  },
  "scripts": {
    "check": "devkit-verify && npm run format:check && npm run lint && npm run typecheck && npm test",
    "format:check": "prettier --check src index.html tsconfig.json tsconfig.test.json eslint.config.mjs prettier.config.mjs vite.config.mjs",
    "lint": "eslint --no-ignore --max-warnings 0 src eslint.config.mjs prettier.config.mjs vite.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "fix": "prettier --write src index.html tsconfig.json tsconfig.test.json eslint.config.mjs prettier.config.mjs vite.config.mjs && eslint --no-ignore --max-warnings 0 --fix src eslint.config.mjs prettier.config.mjs vite.config.mjs",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@docouno/env": "0.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devkit": {
    "sourceDirectories": [
      "src"
    ],
    "typecheckConfigs": [
      "tsconfig.json",
      "tsconfig.test.json"
    ],
    "boundaries": {
      "forbidCrossAppImports": true
    }
  }
}
