{
  "name": "devkit-electron-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "check": "devkit-verify && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "format:check": "prettier --check . \"!package.json\" \"!pnpm-lock.yaml\" \"!pnpm-workspace.yaml\" \"!dist/**\" \"!release/**\" \"!coverage/**\" \"!**/.worktrees/**\"",
    "format": "prettier --write . \"!package.json\" \"!pnpm-lock.yaml\" \"!pnpm-workspace.yaml\" \"!dist/**\" \"!release/**\" \"!coverage/**\" \"!**/.worktrees/**\"",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.mjs",
    "fix": "pnpm run format && eslint --max-warnings 0 --fix . && pnpm run format",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package": "electron-builder --config electron-builder.config.cjs --linux dir --publish never && case $(node -p process.arch) in x64) dir=linux-unpacked ;; arm64) dir=linux-arm64-unpacked ;; *) exit 1 ;; esac && tar -czf release/app-linux.tar.gz -C \"release/$dir\" ."
  },
  "devDependencies": {
    "@docouno/env": "0.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "electron-builder": "26.15.3"
  },
  "devkit": {
    "sourceDirectories": [
      "src"
    ],
    "typecheckConfigs": [
      "tsconfig.json",
      "tsconfig.node.json",
      "tsconfig.test.json"
    ],
    "boundaries": {
      "forbidCrossAppImports": true
    }
  },
  "main": "dist/main/index.js",
  "description": "A React desktop application",
  "author": "Application authors",
  "license": "MIT"
}
