{
  "name": "devkit-node-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "check": "devkit-verify && npm run format:check && npm run lint && npm run typecheck",
    "format:check": "prettier --check . \"!package.json\" \"!package-lock.json\" \"!dist/**\" \"!release/**\" \"!coverage/**\"",
    "format": "prettier --write . \"!package.json\" \"!package-lock.json\" \"!dist/**\" \"!release/**\" \"!coverage/**\"",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fix": "npm run format && eslint --max-warnings 0 --fix . && npm run format",
    "test": "node --test --test-concurrency=2 --test-reporter=@docouno/env/node-test-reporter 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@docouno/env": "0.4.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "devkit": {
    "sourceDirectories": [
      "src"
    ],
    "typecheckConfigs": [
      "tsconfig.json"
    ],
    "boundaries": {
      "forbidCrossAppImports": true
    }
  }
}
